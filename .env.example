# Runtime classification. APP_ENV must be one of development, test, preview, or production.
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Public origin used by Next.js and Better Auth. Do not include a trailing slash.
APP_BASE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Generate with `pnpm exec auth secret`; never commit a real value.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional only during a planned Better Auth secret rotation.
BETTER_AUTH_PREVIOUS_SECRET=

# PostgreSQL. Preview, test, and production must use isolated databases.
DATABASE_URL=postgresql://habitat:habitat@127.0.0.1:5432/habitat_development?schema=public
DIRECT_DATABASE_URL=postgresql://habitat:habitat@127.0.0.1:5432/habitat_development?schema=public
# Required for `pnpm db:migrate:dev` and `pnpm db:migrate:diff`; it must name
# a separate disposable database, never development, preview, or production.
SHADOW_DATABASE_URL=postgresql://habitat:habitat@127.0.0.1:5432/habitat_shadow_development?schema=public
# Destructive integration/E2E setup additionally requires this exact opt-in and
# matching URLs whose database name satisfies ^habitat(?:_[a-z0-9]+)*_test$.
ALLOW_DESTRUCTIVE_TEST_DATABASE=false

# Google Workspace OIDC. The expected hosted domain is a policy hint and is
# checked alongside verified email, an active invitation, and local capability data.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_WORKSPACE_DOMAIN=example.org

# Preview auth is off by default. Origins must be exact and comma-separated;
# never trust a wildcard Vercel domain.
AUTH_ENABLED=true
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Storage adapter. `local` is valid only for development/test.
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=.data/storage
PUBLIC_STORAGE_BASE_URL=http://localhost:3000/api/media

# Optional observability correlation. Never place credentials in log metadata.
LOG_LEVEL=info

# Public Story Submission intake remains disabled unless explicitly enabled.
# Never expose these as NEXT_PUBLIC_* values. The secret must contain at least
# 32 bytes, and the privacy-notice version must be approved before enablement.
PUBLIC_STORY_SUBMISSIONS_ENABLED=false
PUBLIC_STORY_SUBMISSIONS_SECRET=replace-with-at-least-32-random-characters
PUBLIC_STORY_SUBMISSIONS_PRIVACY_NOTICE_VERSION=

# Test auth is local/CI only. See docs/testing/test-auth.md before enabling.
ENABLE_TEST_AUTH=false
TEST_AUTH_SECRET=

# One-time, operator-run bootstrap only. The command refuses to run without
# the exact confirmation phrase and no existing Super Admin.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_CONFIRMATION=
