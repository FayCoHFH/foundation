{
  "name": "fayette-county-habitat-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": ">=10.13.1 <11"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:clean": "rm -rf .next && pnpm db:generate && pnpm build",
    "start": "next start",
    "lint": "eslint .",
    "audit:temporary-reference": "tsx scripts/temporary-reference-audit.ts",
    "deploy:preflight": "tsx scripts/deploy-preflight.ts",
    "production:readiness": "tsx scripts/production-readiness-check.ts",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "NODE_OPTIONS=--conditions=react-server vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "brand:audit": "tsx scripts/brand-compliance-audit.ts final",
    "brand:audit:strict": "BRAND_AUDIT_STRICT=1 tsx scripts/brand-compliance-audit.ts final",
    "brand:runtime": "tsx scripts/brand-compliance-runtime.ts final",
    "brand:runtime:strict": "BRAND_RUNTIME_STRICT=1 tsx scripts/brand-compliance-runtime.ts final",
    "verify:public": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm brand:audit:strict && pnpm brand:runtime:strict",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "PRISMA_REQUIRE_DIRECT_DATABASE_URL=true PRISMA_REQUIRE_SHADOW_DATABASE_URL=true prisma migrate dev",
    "db:migrate:deploy": "PRISMA_REQUIRE_DIRECT_DATABASE_URL=true prisma migrate deploy",
    "db:migrate:status": "PRISMA_REQUIRE_DIRECT_DATABASE_URL=true prisma migrate status",
    "db:migrate:diff": "PRISMA_REQUIRE_DIRECT_DATABASE_URL=true PRISMA_REQUIRE_SHADOW_DATABASE_URL=true prisma migrate diff --from-migrations prisma/migrations --to-config-datasource --exit-code",
    "db:test:assert-migration-environment": "tsx tests/support/assert-prisma-migration-environment.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:legacy-content": "tsx scripts/seed-legacy-content.ts",
    "admin:bootstrap-super-admin": "tsx scripts/bootstrap-super-admin.ts",
    "auth:schema:generate": "auth generate --config ./src/platform/auth/schema-config.ts --output ./tmp/better-auth-schema.prisma --yes",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@better-auth/core": "1.6.29",
    "@better-auth/prisma-adapter": "1.6.29",
    "@better-auth/utils": "0.4.2",
    "@napi-rs/canvas": "0.1.100",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@radix-ui/react-slot": "1.3.3",
    "better-auth": "1.6.29",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "heic-decode": "2.1.0",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "pdfjs-dist": "5.5.207",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "auth": "1.6.29",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "auth>@mrleebo/prisma-ast": "0.16.0",
      "deepmerge-ts": "8.0.0"
    }
  }
}
