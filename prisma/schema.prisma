generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ExternalIdentityProvider {
  GOOGLE
}

enum AuditOutcome {
  SUCCEEDED
  DENIED
  FAILED
}

enum AuditActorKind {
  ADMIN_USER
  SYSTEM
}

enum PublicationKind {
  STORY
  NEWS
}

enum PlacementKey {
  HOME_HERO
  HOME_FEATURED_STORY
  HOME_FEATURED_NEWS
  NEWS_FEATURED
}

enum SiteNoticeSeverity {
  INFO
  IMPORTANT
  URGENT
}

enum SiteNoticeTargetArea {
  SITE_WIDE
  HOMEPAGE
}

enum SiteNoticeLifecycle {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

enum PublicStorySubmissionStatus {
  RECEIVED
  IN_REVIEW
  FOLLOW_UP
  ACCEPTED
  DECLINED
  SPAM
}

enum PublicStorySubmissionAttemptStatus {
  ACTIVE
  SUBMITTED
  EXPIRED
}

enum PublicStorySubmissionMediaStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  REJECTED
  REMOVED
}

enum PublicStorySubmissionMediaRejectionReason {
  UNSUPPORTED_FORMAT
  MIME_TYPE_MISMATCH
  FILE_TOO_LARGE
  SUBMISSION_TOTAL_TOO_LARGE
  DIMENSIONS_EXCEEDED
  MULTI_FRAME_UNSUPPORTED
  CORRUPTED_IMAGE
  DUPLICATE_IMAGE
  PROCESSING_FAILED
}

enum PublicStoryIntakeRateLimitScope {
  NETWORK
  EMAIL
  GLOBAL
}

enum PublicationWorkflowState {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  PENDING_APPROVAL
  APPROVED
}

enum PublicationLifecycleDimension {
  CANDIDATE_WORKFLOW
  RELEASE_SNAPSHOT
  DISCOVERY_DISPOSITION
}

enum PublicationLifecycleAction {
  DRAFT_CREATED
  REVISION_CREATED
  OWNER_ASSIGNED
  SUBMITTED
  CHANGES_REQUESTED
  SENT_FOR_APPROVAL
  APPROVED
  RELEASED
  WITHDRAWN
  ARCHIVED
}

enum PublicationReleaseState {
  UNPUBLISHED
  PUBLISHED
  WITHDRAWN
}

enum PublicationDiscoveryDisposition {
  ACTIVE
  ARCHIVED
}

enum PublicationSnapshotState {
  PUBLISHED
  SUPERSEDED
  WITHDRAWN
}

enum PublicationApprovalDecision {
  APPROVED
}

// Better Auth core model. The application never treats this identity record
// alone as an administrative principal.
model User {
  id              String   @id
  name            String
  email           String   @unique
  emailVerified   Boolean  @default(false)
  image           String?
  workspaceDomain String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts         Account[]
  sessions         Session[]
  adminUser        AdminUser?
  externalIdentity ExternalIdentity? @relation("ExternalIdentityAuthUser")

  @@map("user")
}

// Better Auth core model. Cookie caching is disabled; this row is the source
// of truth on every protected request.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

// Better Auth core model. OAuth token-shaped columns remain for adapter
// compatibility, but application hooks and database checks require them to be
// null. Google `sub` is stored as accountId.
model Account {
  id                    String            @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalIdentity      ExternalIdentity? @relation("ExternalIdentityAuthAccount")

  @@unique([providerId, accountId])
  @@unique([userId, providerId])
  @@index([userId])
  @@map("account")
}

// Better Auth core model. Retained for OAuth state and verification storage.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

// Better Auth database-backed rate limiting works across serverless instances.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model AdminUser {
  id              String          @id @default(uuid()) @db.Uuid
  authUserId      String          @unique
  status          AdminUserStatus @default(INVITED)
  statusChangedAt DateTime        @default(now())
  suspendedAt     DateTime?
  revokedAt       DateTime?
  version         Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  authUser        User            @relation(fields: [authUserId], references: [id], onDelete: Restrict)

  externalIdentities            ExternalIdentity[]
  roleAssignments               UserRole[]
  createdInvitations            AdminInvitation[]                @relation("InvitationCreator")
  acceptedInvitations           AdminInvitation[]                @relation("InvitationAcceptor")
  revokedInvitations            AdminInvitation[]                @relation("InvitationRevoker")
  grantedRoleAssignments        UserRole[]                       @relation("RoleGrantor")
  revokedRoleAssignments        UserRole[]                       @relation("RoleRevoker")
  auditEvents                   AuditEvent[]                     @relation("AuditActor")
  superAdminGrant               SuperAdminGrant?                 @relation("SuperAdminHolder")
  grantedSuperAdminRecords      SuperAdminGrant[]                @relation("SuperAdminGrantor")
  createdPublications           Publication[]                    @relation("PublicationCreator")
  createdRevisions              PublicationRevision[]            @relation("PublicationRevisionCreator")
  editorialResponsibilities     PublicationResponsibility[]      @relation("PublicationEditorialOwner")
  reviewerResponsibilities      PublicationResponsibility[]      @relation("PublicationAssignedReviewer")
  approverResponsibilities      PublicationResponsibility[]      @relation("PublicationAssignedApprover")
  changedResponsibilities       PublicationResponsibility[]      @relation("PublicationResponsibilityChanger")
  publicationTransitions        PublicationLifecycleTransition[] @relation("PublicationTransitionActor")
  publicationApprovals          PublicationApproval[]            @relation("PublicationApprover")
  createdContentPlacements      ContentPlacement[]               @relation("ContentPlacementCreator")
  changedContentPlacements      ContentPlacement[]               @relation("ContentPlacementChanger")
  createdSiteNotices            SiteNotice[]                     @relation("SiteNoticeCreator")
  updatedSiteNotices            SiteNotice[]                     @relation("SiteNoticeUpdater")
  publishedSiteNotices          SiteNotice[]                     @relation("SiteNoticePublisher")
  withdrawnSiteNotices          SiteNotice[]                     @relation("SiteNoticeWithdrawer")
  changedPublicStorySubmissions PublicStorySubmission[]          @relation("PublicStorySubmissionStatusChanger")

  @@index([status])
  @@map("admin_user")
}

model ExternalIdentity {
  id                  String                   @id @default(uuid()) @db.Uuid
  adminUserId         String                   @db.Uuid
  authUserId          String                   @unique
  authAccountId       String                   @unique
  provider            ExternalIdentityProvider
  subject             String
  email               String
  emailVerified       Boolean
  hostedDomain        String
  linkedAt            DateTime                 @default(now())
  lastAuthenticatedAt DateTime                 @default(now())
  adminUser           AdminUser                @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  authUser            User                     @relation("ExternalIdentityAuthUser", fields: [authUserId], references: [id], onDelete: Restrict)
  authAccount         Account                  @relation("ExternalIdentityAuthAccount", fields: [authAccountId], references: [id], onDelete: Restrict)

  @@unique([provider, subject])
  @@unique([adminUserId, provider])
  @@index([adminUserId])
  @@index([authUserId])
  @@index([authAccountId])
  @@index([email])
  @@map("external_identity")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String
  isSystem    Boolean  @default(true)
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions     RolePermission[]
  assignments     UserRole[]
  invitationRoles AdminInvitationRole[]

  @@map("role")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model UserRole {
  id                 String           @id @default(uuid()) @db.Uuid
  adminUserId        String           @db.Uuid
  roleId             String           @db.Uuid
  grantedById        String?          @db.Uuid
  grantedAt          DateTime         @default(now())
  revokedById        String?          @db.Uuid
  sourceInvitationId String?          @db.Uuid
  revokedAt          DateTime?
  assignmentReason   String?
  revocationReason   String?
  adminUser          AdminUser        @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  role               Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy          AdminUser?       @relation("RoleGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy          AdminUser?       @relation("RoleRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  sourceInvitation   AdminInvitation? @relation(fields: [sourceInvitationId], references: [id], onDelete: SetNull)

  @@index([adminUserId, roleId])
  @@index([roleId])
  @@index([grantedById])
  @@index([revokedById])
  @@index([sourceInvitationId])
  @@index([adminUserId, revokedAt])
  @@map("user_role")
}

model AdminInvitation {
  id                    String           @id @default(uuid()) @db.Uuid
  email                 String
  tokenDigest           String           @unique @db.Char(64)
  hostedDomain          String
  status                InvitationStatus @default(PENDING)
  expiresAt             DateTime
  acceptedAt            DateTime?
  acceptedById          String?          @db.Uuid
  revokedAt             DateTime?
  revokedById           String?          @db.Uuid
  createdById           String?          @db.Uuid
  isSuperAdminBootstrap Boolean          @default(false)
  version               Int              @default(1)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  createdBy             AdminUser?       @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  acceptedBy            AdminUser?       @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedBy             AdminUser?       @relation("InvitationRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  intendedRoles            AdminInvitationRole[]
  activatedRoleAssignments UserRole[]

  @@index([email, status])
  @@index([expiresAt])
  @@index([createdById])
  @@index([acceptedById])
  @@index([revokedById])
  @@map("admin_invitation")
}

model AdminInvitationRole {
  invitationId String          @db.Uuid
  roleId       String          @db.Uuid
  invitation   AdminInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([invitationId, roleId])
  @@index([roleId])
  @@map("admin_invitation_role")
}

model SuperAdminGrant {
  id          String     @id @default(uuid()) @db.Uuid
  adminUserId String     @unique @db.Uuid
  grantedById String?    @db.Uuid
  grantedAt   DateTime   @default(now())
  reason      String
  adminUser   AdminUser  @relation("SuperAdminHolder", fields: [adminUserId], references: [id], onDelete: Restrict)
  grantedBy   AdminUser? @relation("SuperAdminGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([grantedById])
  @@map("super_admin_grant")
}

model AuditEvent {
  id               String         @id @default(uuid()) @db.Uuid
  occurredAt       DateTime       @default(now())
  actorAdminUserId String?        @db.Uuid
  actorKind        AuditActorKind
  action           String
  targetType       String
  targetId         String?
  outcome          AuditOutcome
  correlationId    String         @db.Uuid
  summary          Json
  actorAdminUser   AdminUser?     @relation("AuditActor", fields: [actorAdminUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([actorAdminUserId, occurredAt])
  @@index([action, occurredAt])
  @@index([targetType, targetId])
  @@index([correlationId])
  @@map("audit_event")
}

// The narrow shared spine for typed Communications authoring. C1 creates only
// Story details; NEWS remains a closed discriminator reserved for a later slice.
model Publication {
  id                   String                           @id @default(uuid()) @db.Uuid
  kind                 PublicationKind
  workflowState        PublicationWorkflowState         @default(DRAFT)
  version              Int                              @default(1)
  currentRevisionId    String?                          @unique @db.Uuid
  approvedRevisionId   String?                          @unique @db.Uuid
  approvedContentHash  String?                          @db.Char(64)
  slug                 String?                          @unique
  releaseState         PublicationReleaseState          @default(UNPUBLISHED)
  discoveryDisposition PublicationDiscoveryDisposition  @default(ACTIVE)
  activeSnapshotId     String?                          @unique @db.Uuid
  createdById          String                           @db.Uuid
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  createdBy            AdminUser                        @relation("PublicationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  story                Story?
  newsItem             NewsItem?
  responsibility       PublicationResponsibility?
  revisions            PublicationRevision[]            @relation("PublicationRevisions")
  currentRevision      PublicationRevision?             @relation("PublicationCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  approvedRevision     PublicationRevision?             @relation("PublicationApprovedRevision", fields: [approvedRevisionId], references: [id], onDelete: SetNull)
  transitions          PublicationLifecycleTransition[]
  approvals            PublicationApproval[]
  snapshots            PublicationSnapshot[]            @relation("PublicationSnapshots")
  activeSnapshot       PublicationSnapshot?             @relation("PublicationActiveSnapshot", fields: [activeSnapshotId], references: [id], onDelete: SetNull)
  publicProjection     PublicStoryProjection?
  publicNewsProjection PublicNewsProjection?
  contentPlacements    ContentPlacement[]

  @@unique([id, version])
  @@index([kind, workflowState])
  @@index([releaseState, discoveryDisposition])
  @@index([createdById])
  @@map("publication")
}

// Immutable public evidence generated only by an approved release command.
model PublicationSnapshot {
  id                   String                   @id @default(uuid()) @db.Uuid
  publicationId        String                   @db.Uuid
  sourceRevisionId     String                   @db.Uuid
  sourceContentHash    String                   @db.Char(64)
  slug                 String                   @db.VarChar(160)
  payload              Json
  activatedAt          DateTime                 @default(now())
  state                PublicationSnapshotState @default(PUBLISHED)
  publication          Publication              @relation("PublicationSnapshots", fields: [publicationId], references: [id], onDelete: Restrict)
  sourceRevision       PublicationRevision      @relation(fields: [sourceRevisionId], references: [id], onDelete: Restrict)
  activeFor            Publication[]            @relation("PublicationActiveSnapshot")
  publicProjection     PublicStoryProjection?
  publicNewsProjection PublicNewsProjection?

  @@index([publicationId, activatedAt])
  @@index([state])
  @@map("publication_snapshot")
}

// Read model for public Story detail. It is intentionally detached from
// mutable authoring tables; the public route reads this projection only.
model PublicStoryProjection {
  id            String              @id @default(uuid()) @db.Uuid
  publicationId String              @unique @db.Uuid
  snapshotId    String              @unique @db.Uuid
  slug          String              @unique @db.VarChar(160)
  headline      String
  deck          String?
  excerpt       String
  body          Json
  publishedAt   DateTime
  updatedAt     DateTime            @updatedAt
  publication   Publication         @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  snapshot      PublicationSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@map("public_story_projection")
}

// Read model for concise, chronological public News. Like Story projections,
// it is populated only by an approved release transaction.
model PublicNewsProjection {
  id            String              @id @default(uuid()) @db.Uuid
  publicationId String              @unique @db.Uuid
  snapshotId    String              @unique @db.Uuid
  slug          String              @unique @db.VarChar(160)
  headline      String
  summary       String
  body          Json
  publishedAt   DateTime
  expiresAt     DateTime?
  updatedAt     DateTime            @updatedAt
  publication   Publication         @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  snapshot      PublicationSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@index([expiresAt, publishedAt])
  @@map("public_news_projection")
}

// Typed root. It has no public fields or route in C1.
model Story {
  id            String      @id @default(uuid()) @db.Uuid
  publicationId String      @unique @db.Uuid
  createdAt     DateTime    @default(now())
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Restrict)

  @@map("story")
}

// Typed News root. Public content continues to live only in projections.
model NewsItem {
  id            String      @id @default(uuid()) @db.Uuid
  publicationId String      @unique @db.Uuid
  createdAt     DateTime    @default(now())
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Restrict)

  @@map("news_item")
}

// Code-owned singleton slots with a closed target-kind catalog in the
// application service. Rows are retained when superseded, ended, or cancelled.
model ContentPlacement {
  id                   String       @id @default(uuid()) @db.Uuid
  key                  PlacementKey
  publicationId        String       @db.Uuid
  startsAt             DateTime     @default(now())
  endsAt               DateTime?
  cancelledAt          DateTime?
  version              Int          @default(1)
  createdByAdminUserId String       @db.Uuid
  updatedByAdminUserId String       @db.Uuid
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  publication          Publication  @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  createdBy            AdminUser    @relation("ContentPlacementCreator", fields: [createdByAdminUserId], references: [id], onDelete: Restrict)
  updatedBy            AdminUser    @relation("ContentPlacementChanger", fields: [updatedByAdminUserId], references: [id], onDelete: Restrict)

  @@index([key, startsAt])
  @@index([publicationId])
  @@map("content_placement")
}

// Small, temporary operational communications. Site Notices are not
// Publications, placements, or permanent public archive records.
model SiteNotice {
  id                     String               @id @default(uuid()) @db.Uuid
  title                  String               @db.VarChar(160)
  message                String               @db.VarChar(500)
  severity               SiteNoticeSeverity
  targetArea             SiteNoticeTargetArea
  ctaLabel               String?              @db.VarChar(80)
  ctaUrl                 String?              @db.VarChar(2048)
  lifecycle              SiteNoticeLifecycle  @default(DRAFT)
  startsAt               DateTime?
  endsAt                 DateTime?
  version                Int                  @default(1)
  createdByAdminUserId   String               @db.Uuid
  updatedByAdminUserId   String               @db.Uuid
  publishedByAdminUserId String?              @db.Uuid
  publishedAt            DateTime?
  withdrawnByAdminUserId String?              @db.Uuid
  withdrawnAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  createdBy              AdminUser            @relation("SiteNoticeCreator", fields: [createdByAdminUserId], references: [id], onDelete: Restrict)
  updatedBy              AdminUser            @relation("SiteNoticeUpdater", fields: [updatedByAdminUserId], references: [id], onDelete: Restrict)
  publishedBy            AdminUser?           @relation("SiteNoticePublisher", fields: [publishedByAdminUserId], references: [id], onDelete: Restrict)
  withdrawnBy            AdminUser?           @relation("SiteNoticeWithdrawer", fields: [withdrawnByAdminUserId], references: [id], onDelete: Restrict)

  @@unique([id, version])
  @@index([targetArea, lifecycle, startsAt, endsAt])
  @@index([lifecycle, updatedAt, id])
  @@map("site_notice")
}

// Confidential, text-only public story intake. This is not a Story,
// Publication, projection, or media-bearing authoring record.
model PublicStorySubmission {
  id                                     String                         @id @default(uuid()) @db.Uuid
  submitterName                          String                         @db.VarChar(120)
  submitterEmail                         String                         @db.VarChar(254)
  relationshipToHabitat                  String                         @db.VarChar(160)
  suggestedTitle                         String?                        @db.VarChar(160)
  storyText                              String                         @db.Text
  contactConsent                         Boolean
  privacyNoticeVersion                   String                         @db.VarChar(64)
  privacyNoticeAcceptedAt                DateTime
  editorialReviewAcknowledged            Boolean
  sensitiveDataWarningAcknowledged       Boolean
  publicationInterest                    Boolean?
  involvesMinor                          Boolean                        @default(false)
  involvesHomeownerOrApplicant           Boolean                        @default(false)
  containsSensitivePersonalCircumstances Boolean                        @default(false)
  status                                 PublicStorySubmissionStatus    @default(RECEIVED)
  internalReviewNote                     String?                        @db.VarChar(2000)
  version                                Int                            @default(1)
  receivedAt                             DateTime                       @default(now())
  statusChangedAt                        DateTime                       @default(now())
  statusChangedByAdminUserId             String?                        @db.Uuid
  createdAt                              DateTime                       @default(now())
  updatedAt                              DateTime                       @updatedAt
  statusChangedBy                        AdminUser?                     @relation("PublicStorySubmissionStatusChanger", fields: [statusChangedByAdminUserId], references: [id], onDelete: SetNull)
  intakeTokenUse                         PublicStoryIntakeTokenUse?
  submissionAttempts                     PublicStorySubmissionAttempt[]
  submissionMedia                        PublicStorySubmissionMedia[]

  @@unique([id, version])
  @@index([status, receivedAt, id])
  @@index([receivedAt, id])
  @@map("public_story_submission")
}

// Short-lived privacy-preserving abuse-control state. These rows never store
// raw IP addresses, email addresses, user agents, tokens, or request bodies.
model PublicStoryIntakeRateLimitBucket {
  id              String                          @id @default(uuid()) @db.Uuid
  scope           PublicStoryIntakeRateLimitScope
  keyHash         String                          @db.Char(64)
  windowStartedAt DateTime
  expiresAt       DateTime
  count           Int                             @default(0)
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  @@unique([scope, keyHash, windowStartedAt])
  @@index([expiresAt])
  @@map("public_story_intake_rate_limit_bucket")
}

// A consumed signed form token is retained only long enough to prevent replay
// and to make retries idempotent. The raw token and nonce are never persisted.
model PublicStoryIntakeTokenUse {
  id           String                 @id @default(uuid()) @db.Uuid
  tokenHash    String                 @unique @db.Char(64)
  expiresAt    DateTime
  consumedAt   DateTime               @default(now())
  submissionId String?                @unique @db.Uuid
  submission   PublicStorySubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@map("public_story_intake_token_use")
}

// Confidential, pre-submission ownership boundary for future Story Submission
// uploads. The raw recovery token never persists; its SHA-256 hash is the
// lookup credential, and no public route or URL is introduced here.
model PublicStorySubmissionAttempt {
  id                String                             @id @default(uuid()) @db.Uuid
  recoveryTokenHash String                             @unique @db.Char(64)
  status            PublicStorySubmissionAttemptStatus @default(ACTIVE)
  expiresAt         DateTime
  submissionId      String?                            @db.Uuid
  version           Int                                @default(1)
  createdAt         DateTime                           @default(now())
  updatedAt         DateTime                           @updatedAt
  submission        PublicStorySubmission?             @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  media             PublicStorySubmissionMedia[]

  @@unique([id, version])
  @@index([status, expiresAt, id])
  @@map("public_story_submission_attempt")
}

// Private quarantine record. It is intentionally not a MediaAsset, MediaUsage,
// Publication, projection, or public library record.
model PublicStorySubmissionMedia {
  id                                     String                                     @id @default(uuid()) @db.Uuid
  attemptId                              String                                     @db.Uuid
  submissionId                           String?                                    @db.Uuid
  originalFilename                       String?                                    @db.VarChar(255)
  declaredMimeType                       String?                                    @db.VarChar(127)
  originalByteSize                       Int?
  ordinal                                Int?
  description                            String?                                    @db.VarChar(300)
  suggestedPhotoCredit                   String?                                    @db.VarChar(160)
  involvesMinor                          Boolean                                    @default(false)
  involvesHomeownerOrApplicant           Boolean                                    @default(false)
  involvesOtherIdentifiablePerson        Boolean                                    @default(false)
  depictsPrivateResidence                Boolean                                    @default(false)
  containsSensitivePersonalCircumstances Boolean                                    @default(false)
  technicalStatus                        PublicStorySubmissionMediaStatus           @default(PENDING_UPLOAD)
  rejectionReason                        PublicStorySubmissionMediaRejectionReason?
  quarantineStorageKey                   String?                                    @db.VarChar(240)
  detectedFormat                         String?                                    @db.VarChar(16)
  sourceWidth                            Int?
  sourceHeight                           Int?
  reviewDerivativeStorageKey             String?                                    @db.VarChar(240)
  reviewDerivativeFormat                 String?                                    @db.VarChar(16)
  reviewDerivativeWidth                  Int?
  reviewDerivativeHeight                 Int?
  reviewDerivativeByteSize               Int?
  processedAt                            DateTime?
  originalSha256                         String?                                    @db.Char(64)
  uploadAuthorizationNonceHash           String                                     @unique @db.Char(64)
  removedAt                              DateTime?
  rejectedAt                             DateTime?
  binaryDeletedAt                        DateTime?
  version                                Int                                        @default(1)
  createdAt                              DateTime                                   @default(now())
  updatedAt                              DateTime                                   @updatedAt
  attempt                                PublicStorySubmissionAttempt               @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  submission                             PublicStorySubmission?                     @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([id, version])
  @@unique([attemptId, ordinal])
  @@index([attemptId, technicalStatus, ordinal])
  @@index([attemptId, originalSha256])
  @@index([submissionId, ordinal])
  @@index([technicalStatus, binaryDeletedAt])
  @@map("public_story_submission_media")
}

// Private work-management assignment. This never supplies a public byline.
model PublicationResponsibility {
  publicationId               String      @id @db.Uuid
  editorialOwnerAdminUserId   String      @db.Uuid
  assignedReviewerAdminUserId String?     @db.Uuid
  assignedApproverAdminUserId String?     @db.Uuid
  changedByAdminUserId        String      @db.Uuid
  reassignmentReason          String?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  publication                 Publication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  editorialOwner              AdminUser   @relation("PublicationEditorialOwner", fields: [editorialOwnerAdminUserId], references: [id], onDelete: Restrict)
  assignedReviewer            AdminUser?  @relation("PublicationAssignedReviewer", fields: [assignedReviewerAdminUserId], references: [id], onDelete: SetNull)
  assignedApprover            AdminUser?  @relation("PublicationAssignedApprover", fields: [assignedApproverAdminUserId], references: [id], onDelete: SetNull)
  changedBy                   AdminUser   @relation("PublicationResponsibilityChanger", fields: [changedByAdminUserId], references: [id], onDelete: Restrict)

  @@index([editorialOwnerAdminUserId])
  @@index([assignedReviewerAdminUserId])
  @@index([assignedApproverAdminUserId])
  @@map("publication_responsibility")
}

// Revision data is immutable. The C1 trigger rejects UPDATE and DELETE.
model PublicationRevision {
  id                   String                           @id @default(uuid()) @db.Uuid
  publicationId        String                           @db.Uuid
  number               Int
  parentRevisionId     String?                          @db.Uuid
  headline             String
  deck                 String?
  excerpt              String
  newsSummary          String?
  newsExpiresAt        DateTime?
  body                 Json
  schemaVersion        Int
  contentHash          String                           @db.Char(64)
  contentHashVersion   Int                              @default(1)
  createdByAdminUserId String                           @db.Uuid
  createdAt            DateTime                         @default(now())
  publication          Publication                      @relation("PublicationRevisions", fields: [publicationId], references: [id], onDelete: Restrict)
  parentRevision       PublicationRevision?             @relation("PublicationRevisionLineage", fields: [parentRevisionId], references: [id], onDelete: Restrict)
  successorRevisions   PublicationRevision[]            @relation("PublicationRevisionLineage")
  createdBy            AdminUser                        @relation("PublicationRevisionCreator", fields: [createdByAdminUserId], references: [id], onDelete: Restrict)
  currentFor           Publication?                     @relation("PublicationCurrentRevision")
  approvedFor          Publication?                     @relation("PublicationApprovedRevision")
  lifecycleTransitions PublicationLifecycleTransition[]
  approval             PublicationApproval?
  publicationSnapshots PublicationSnapshot[]

  @@unique([publicationId, number])
  @@index([publicationId, createdAt])
  @@index([createdByAdminUserId])
  @@index([parentRevisionId])
  @@map("publication_revision")
}

model PublicationLifecycleTransition {
  id               String                        @id @default(uuid()) @db.Uuid
  publicationId    String                        @db.Uuid
  dimension        PublicationLifecycleDimension
  action           PublicationLifecycleAction
  fromState        PublicationWorkflowState?
  toState          PublicationWorkflowState?
  revisionId       String?                       @db.Uuid
  contentHash      String?                       @db.Char(64)
  actorAdminUserId String?                       @db.Uuid
  reason           String?
  correlationId    String                        @db.Uuid
  occurredAt       DateTime                      @default(now())
  publication      Publication                   @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  revision         PublicationRevision?          @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  actor            AdminUser?                    @relation("PublicationTransitionActor", fields: [actorAdminUserId], references: [id], onDelete: SetNull)

  @@index([publicationId, occurredAt])
  @@index([revisionId])
  @@index([actorAdminUserId])
  @@index([correlationId])
  @@map("publication_lifecycle_transition")
}

model PublicationApproval {
  id                    String                      @id @default(uuid()) @db.Uuid
  publicationId         String                      @db.Uuid
  revisionId            String                      @unique @db.Uuid
  contentHash           String                      @db.Char(64)
  contentHashVersion    Int                         @default(1)
  decision              PublicationApprovalDecision @default(APPROVED)
  policyVersion         Int                         @default(1)
  approvedByAdminUserId String                      @db.Uuid
  approvedAt            DateTime                    @default(now())
  overrideReason        String?
  publication           Publication                 @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  revision              PublicationRevision         @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  approvedBy            AdminUser                   @relation("PublicationApprover", fields: [approvedByAdminUserId], references: [id], onDelete: Restrict)

  @@index([publicationId, approvedAt])
  @@index([approvedByAdminUserId])
  @@map("publication_approval")
}
