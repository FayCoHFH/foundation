  involvesHomeownerOrApplicant           Boolean                               @default(false)
  containsSensitivePersonalCircumstances Boolean                               @default(false)
  status                                 PublicStorySubmissionStatus           @default(RECEIVED)
  internalReviewNote                     String?                               @db.VarChar(2000)
  version                                Int                                   @default(1)
  receivedAt                             DateTime                              @default(now())
  statusChangedAt                        DateTime                              @default(now())
  statusChangedByAdminUserId             String?                               @db.Uuid
