generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ExternalIdentityProvider {
  GOOGLE
}

enum AuditOutcome {
  SUCCEEDED
  DENIED
  FAILED
}

enum AuditActorKind {
  ADMIN_USER
  SYSTEM
}

enum PublicationKind {
  STORY
  NEWS
  PROJECT
}

enum ProjectType {
  NEW_HOME
  HOME_REPAIR
  REHABILITATION
  ACCESSIBILITY
  COMMUNITY
  OTHER
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  PAUSED
  CANCELLED
}

enum PlacementKey {
  HOME_HERO
  HOME_FEATURED_STORY
  HOME_FEATURED_NEWS
  NEWS_FEATURED
}

enum SiteNoticeSeverity {
  INFO
  IMPORTANT
  URGENT
}

enum SiteNoticeTargetArea {
  SITE_WIDE
  HOMEPAGE
}

enum SiteNoticeLifecycle {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

enum PublicStorySubmissionStatus {
  RECEIVED
  IN_REVIEW
  FOLLOW_UP
  ACCEPTED
  DECLINED
  SPAM
}

enum PublicStorySubmissionAttemptStatus {
  ACTIVE
  SUBMITTED
  EXPIRED
}

enum PublicStorySubmissionMediaStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  REJECTED
  REMOVED
}

enum PublicStorySubmissionMediaRejectionReason {
  UNSUPPORTED_FORMAT
  MIME_TYPE_MISMATCH
  FILE_TOO_LARGE
  SUBMISSION_TOTAL_TOO_LARGE
  DIMENSIONS_EXCEEDED
  MULTI_FRAME_UNSUPPORTED
  CORRUPTED_IMAGE
  DUPLICATE_IMAGE
  PROCESSING_FAILED
}

enum PublicStorySubmissionMediaSubjectType {
  IDENTIFIABLE_ADULT
  MINOR
}

enum PublicStorySubmissionMediaClearanceType {
  IMAGE_RIGHTS
  IDENTIFIABLE_ADULT
  MINOR_GUARDIAN
  HOMEOWNER_APPLICANT
  PRIVATE_RESIDENCE
  SENSITIVE_CIRCUMSTANCES
  SUBMITTER_LIKENESS
}

enum PublicStorySubmissionMediaClearanceStatus {
  PENDING
  VERIFIED
  REJECTED
  REVOKED
}

// A confidential, independently versioned technical record for evidence used
// to support a clearance. It is deliberately not a MediaAsset or publication
// attachment, even when the source bytes are an image.
enum PublicStorySubmissionMediaClearanceEvidenceStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  REJECTED
  REMOVED
}

enum PublicStorySubmissionMediaClearanceEvidenceFormat {
  PDF
  JPEG
  PNG
  WEBP
  HEIF
}

enum PublicStorySubmissionMediaClearanceEvidenceRejectionReason {
  UNSUPPORTED_FORMAT
  MIME_TYPE_MISMATCH
  FILE_TOO_LARGE
  CORRUPTED_FILE
  PDF_ENCRYPTED
  PDF_PAGE_LIMIT_EXCEEDED
  PDF_UNSAFE_STRUCTURE
  DIMENSIONS_EXCEEDED
  MULTI_FRAME_UNSUPPORTED
  PROCESSING_FAILED
}

enum PublicStorySubmissionMediaEvidenceType {
  EXISTING_HABITAT_RELEASE
  NEW_RELEASE
  OTHER_APPROVED_AUTHORIZATION
  SUBMITTER_LIKENESS_CONSENT
  STAFF_PRIVACY_REVIEW
}

enum PublicStorySubmissionMediaClearanceRevocationReason {
  SUBJECT_REQUEST
  STAFF_REVIEW
  EVIDENCE_INVALIDATED
}

enum PublicStorySubmissionMediaUse {
  WEBSITE_PUBLICATION
  SOCIAL_MEDIA
  PRINT
  FUNDRAISING_PROMOTIONAL
  PAID_ADVERTISING
}

enum MediaAssetLifecycle {
  ACTIVE
  ARCHIVED
}

enum MediaAssetFormat {
  JPEG
}

enum MediaAssetCreditTreatment {
  VERIFIED_CREDIT
  ORGANIZATIONAL_CREDIT
  NO_PUBLIC_CREDIT
}

enum MediaUsageSubjectType {
  STORY_REVISION
  NEWS_REVISION
  PUBLICATION
}

enum PublicStorySubmissionMediaRestrictionState {
  ACTIVE
  RESTORED
}

enum PublicStorySubmissionMediaRestrictionReason {
  CLEARANCE_EXPIRED
  CLEARANCE_REVOKED
  CLEARANCE_INSUFFICIENT
  PRIVACY_CONCERN
  SUBJECT_REVOCATION_REQUEST
  STAFF_REVIEW_REQUIRED
}

enum PublicStorySubmissionMediaRevocationRequestStatus {
  OPEN
  RESOLVED
}

enum PublicStoryIntakeRateLimitScope {
  NETWORK
  EMAIL
  GLOBAL
}

enum PublicationWorkflowState {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  PENDING_APPROVAL
  APPROVED
}

enum PublicationLifecycleDimension {
  CANDIDATE_WORKFLOW
  RELEASE_SNAPSHOT
  DISCOVERY_DISPOSITION
}

enum PublicationLifecycleAction {
  DRAFT_CREATED
  REVISION_CREATED
  OWNER_ASSIGNED
  SUBMITTED
  CHANGES_REQUESTED
  SENT_FOR_APPROVAL
  APPROVED
  RELEASED
  WITHDRAWN
  ARCHIVED
}

enum PublicationReleaseState {
  UNPUBLISHED
  PUBLISHED
  WITHDRAWN
}

enum PublicationDiscoveryDisposition {
  ACTIVE
  ARCHIVED
}

enum PublicationSnapshotState {
  PUBLISHED
  SUPERSEDED
  WITHDRAWN
}

enum PublicationApprovalDecision {
  APPROVED
}

// Better Auth core model. The application never treats this identity record
// alone as an administrative principal.
model User {
  id              String   @id
  name            String
  email           String   @unique
  emailVerified   Boolean  @default(false)
  image           String?
  workspaceDomain String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts         Account[]
  sessions         Session[]
  adminUser        AdminUser?
  externalIdentity ExternalIdentity? @relation("ExternalIdentityAuthUser")

  @@map("user")
}

// Better Auth core model. Cookie caching is disabled; this row is the source
// of truth on every protected request.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

// Better Auth core model. OAuth token-shaped columns remain for adapter
// compatibility, but application hooks and database checks require them to be
// null. Google `sub` is stored as accountId.
model Account {
  id                    String            @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalIdentity      ExternalIdentity? @relation("ExternalIdentityAuthAccount")

  @@unique([providerId, accountId])
  @@unique([userId, providerId])
  @@index([userId])
  @@map("account")
}

// Better Auth core model. Retained for OAuth state and verification storage.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

// Better Auth database-backed rate limiting works across serverless instances.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model AdminUser {
  id              String          @id @default(uuid()) @db.Uuid
  authUserId      String          @unique
  status          AdminUserStatus @default(INVITED)
  statusChangedAt DateTime        @default(now())
  suspendedAt     DateTime?
  revokedAt       DateTime?
  version         Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  authUser        User            @relation(fields: [authUserId], references: [id], onDelete: Restrict)

  externalIdentities                        ExternalIdentity[]
  roleAssignments                           UserRole[]
  createdInvitations                        AdminInvitation[]                             @relation("InvitationCreator")
  acceptedInvitations                       AdminInvitation[]                             @relation("InvitationAcceptor")
  revokedInvitations                        AdminInvitation[]                             @relation("InvitationRevoker")
  grantedRoleAssignments                    UserRole[]                                    @relation("RoleGrantor")
  revokedRoleAssignments                    UserRole[]                                    @relation("RoleRevoker")
  auditEvents                               AuditEvent[]                                  @relation("AuditActor")
  superAdminGrant                           SuperAdminGrant?                              @relation("SuperAdminHolder")
  grantedSuperAdminRecords                  SuperAdminGrant[]                             @relation("SuperAdminGrantor")
  createdPublications                       Publication[]                                 @relation("PublicationCreator")
  convertedStorySubmissions                 PublicStorySubmissionStoryConversion[]        @relation("StorySubmissionConversionActor")
  createdRevisions                          PublicationRevision[]                         @relation("PublicationRevisionCreator")
  editorialResponsibilities                 PublicationResponsibility[]                   @relation("PublicationEditorialOwner")
  reviewerResponsibilities                  PublicationResponsibility[]                   @relation("PublicationAssignedReviewer")
  approverResponsibilities                  PublicationResponsibility[]                   @relation("PublicationAssignedApprover")
  changedResponsibilities                   PublicationResponsibility[]                   @relation("PublicationResponsibilityChanger")
  publicationTransitions                    PublicationLifecycleTransition[]              @relation("PublicationTransitionActor")
  publicationApprovals                      PublicationApproval[]                         @relation("PublicationApprover")
  createdContentPlacements                  ContentPlacement[]                            @relation("ContentPlacementCreator")
  changedContentPlacements                  ContentPlacement[]                            @relation("ContentPlacementChanger")
  createdSiteNotices                        SiteNotice[]                                  @relation("SiteNoticeCreator")
  updatedSiteNotices                        SiteNotice[]                                  @relation("SiteNoticeUpdater")
  publishedSiteNotices                      SiteNotice[]                                  @relation("SiteNoticePublisher")
  withdrawnSiteNotices                      SiteNotice[]                                  @relation("SiteNoticeWithdrawer")
  changedPublicStorySubmissions             PublicStorySubmission[]                       @relation("PublicStorySubmissionStatusChanger")
  verifiedSubmissionMediaClearances         PublicStorySubmissionMediaClearance[]         @relation("SubmissionMediaClearanceVerifier")
  revokedSubmissionMediaClearances          PublicStorySubmissionMediaClearance[]         @relation("SubmissionMediaClearanceRevoker")
  restrictedSubmissionMedia                 PublicStorySubmissionMediaRestriction[]       @relation("SubmissionMediaRestrictionCreator")
  restoredSubmissionMediaRestrictions       PublicStorySubmissionMediaRestriction[]       @relation("SubmissionMediaRestrictionRestorer")
  resolvedSubmissionMediaRevocationRequests PublicStorySubmissionMediaRevocationRequest[] @relation("SubmissionMediaRevocationRequestResolver")
  createdMediaAssets                        MediaAsset[]                                  @relation("MediaAssetCreator")
  promotedSubmissionMedia                   PublicStorySubmissionMediaPromotion[]         @relation("MediaPromotionActor")

  @@index([status])
  @@map("admin_user")
}

model ExternalIdentity {
  id                  String                   @id @default(uuid()) @db.Uuid
  adminUserId         String                   @db.Uuid
  authUserId          String                   @unique
  authAccountId       String                   @unique
  provider            ExternalIdentityProvider
  subject             String
  email               String
  emailVerified       Boolean
  hostedDomain        String
  linkedAt            DateTime                 @default(now())
  lastAuthenticatedAt DateTime                 @default(now())
  adminUser           AdminUser                @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  authUser            User                     @relation("ExternalIdentityAuthUser", fields: [authUserId], references: [id], onDelete: Restrict)
  authAccount         Account                  @relation("ExternalIdentityAuthAccount", fields: [authAccountId], references: [id], onDelete: Restrict)

  @@unique([provider, subject])
  @@unique([adminUserId, provider])
  @@index([adminUserId])
  @@index([authUserId])
  @@index([authAccountId])
  @@index([email])
  @@map("external_identity")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String
  isSystem    Boolean  @default(true)
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions     RolePermission[]
  assignments     UserRole[]
  invitationRoles AdminInvitationRole[]

  @@map("role")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model UserRole {
  id                 String           @id @default(uuid()) @db.Uuid
  adminUserId        String           @db.Uuid
  roleId             String           @db.Uuid
  grantedById        String?          @db.Uuid
  grantedAt          DateTime         @default(now())
  revokedById        String?          @db.Uuid
  sourceInvitationId String?          @db.Uuid
  revokedAt          DateTime?
  assignmentReason   String?
  revocationReason   String?
  adminUser          AdminUser        @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  role               Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy          AdminUser?       @relation("RoleGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy          AdminUser?       @relation("RoleRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  sourceInvitation   AdminInvitation? @relation(fields: [sourceInvitationId], references: [id], onDelete: SetNull)

  @@index([adminUserId, roleId])
  @@index([roleId])
  @@index([grantedById])
  @@index([revokedById])
  @@index([sourceInvitationId])
  @@index([adminUserId, revokedAt])
  @@map("user_role")
}

model AdminInvitation {
  id                    String           @id @default(uuid()) @db.Uuid
  email                 String
  tokenDigest           String           @unique @db.Char(64)
  hostedDomain          String
  status                InvitationStatus @default(PENDING)
  expiresAt             DateTime
  acceptedAt            DateTime?
  acceptedById          String?          @db.Uuid
  revokedAt             DateTime?
  revokedById           String?          @db.Uuid
  createdById           String?          @db.Uuid
  isSuperAdminBootstrap Boolean          @default(false)
  version               Int              @default(1)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  createdBy             AdminUser?       @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  acceptedBy            AdminUser?       @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedBy             AdminUser?       @relation("InvitationRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  intendedRoles            AdminInvitationRole[]
  activatedRoleAssignments UserRole[]

  @@index([email, status])
  @@index([expiresAt])
  @@index([createdById])
  @@index([acceptedById])
  @@index([revokedById])
  @@map("admin_invitation")
}

model AdminInvitationRole {
  invitationId String          @db.Uuid
  roleId       String          @db.Uuid
  invitation   AdminInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([invitationId, roleId])
  @@index([roleId])
  @@map("admin_invitation_role")
}

model SuperAdminGrant {
  id          String     @id @default(uuid()) @db.Uuid
  adminUserId String     @unique @db.Uuid
  grantedById String?    @db.Uuid
  grantedAt   DateTime   @default(now())
  reason      String
  adminUser   AdminUser  @relation("SuperAdminHolder", fields: [adminUserId], references: [id], onDelete: Restrict)
  grantedBy   AdminUser? @relation("SuperAdminGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([grantedById])
  @@map("super_admin_grant")
}

model AuditEvent {
  id               String         @id @default(uuid()) @db.Uuid
  occurredAt       DateTime       @default(now())
  actorAdminUserId String?        @db.Uuid
  actorKind        AuditActorKind
  action           String
  targetType       String
  targetId         String?
  outcome          AuditOutcome
  correlationId    String         @db.Uuid
  summary          Json
  actorAdminUser   AdminUser?     @relation("AuditActor", fields: [actorAdminUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([actorAdminUserId, occurredAt])
  @@index([action, occurredAt])
  @@index([targetType, targetId])
  @@index([correlationId])
  @@map("audit_event")
}

// The shared spine for typed Communications authoring. Each discriminator has
// its own typed root and revision details; public content is projection-only.
model Publication {
  id                      String                           @id @default(uuid()) @db.Uuid
  kind                    PublicationKind
  workflowState           PublicationWorkflowState         @default(DRAFT)
  version                 Int                              @default(1)
  currentRevisionId       String?                          @unique @db.Uuid
  approvedRevisionId      String?                          @unique @db.Uuid
  approvedContentHash     String?                          @db.Char(64)
  slug                    String?                          @unique
  releaseState            PublicationReleaseState          @default(UNPUBLISHED)
  discoveryDisposition    PublicationDiscoveryDisposition  @default(ACTIVE)
  activeSnapshotId        String?                          @unique @db.Uuid
  createdById             String                           @db.Uuid
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt
  createdBy               AdminUser                        @relation("PublicationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  story                   Story?
  newsItem                NewsItem?
  project                 Project?
  responsibility          PublicationResponsibility?
  revisions               PublicationRevision[]            @relation("PublicationRevisions")
  currentRevision         PublicationRevision?             @relation("PublicationCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  approvedRevision        PublicationRevision?             @relation("PublicationApprovedRevision", fields: [approvedRevisionId], references: [id], onDelete: SetNull)
  transitions             PublicationLifecycleTransition[]
  approvals               PublicationApproval[]
  snapshots               PublicationSnapshot[]            @relation("PublicationSnapshots")
  activeSnapshot          PublicationSnapshot?             @relation("PublicationActiveSnapshot", fields: [activeSnapshotId], references: [id], onDelete: SetNull)
  publicProjection        PublicStoryProjection?
  publicNewsProjection    PublicNewsProjection?
  publicProjectProjection PublicProjectProjection?
  contentPlacements       ContentPlacement[]

  @@unique([id, version])
  @@index([kind, workflowState])
  @@index([releaseState, discoveryDisposition])
  @@index([createdById])
  @@map("publication")
}

// Immutable public evidence generated only by an approved release command.
model PublicationSnapshot {
  id                      String                   @id @default(uuid()) @db.Uuid
  publicationId           String                   @db.Uuid
  sourceRevisionId        String                   @db.Uuid
  sourceContentHash       String                   @db.Char(64)
  slug                    String                   @db.VarChar(160)
  payload                 Json
  activatedAt             DateTime                 @default(now())
  state                   PublicationSnapshotState @default(PUBLISHED)
  publication             Publication              @relation("PublicationSnapshots", fields: [publicationId], references: [id], onDelete: Restrict)
  sourceRevision          PublicationRevision      @relation(fields: [sourceRevisionId], references: [id], onDelete: Restrict)
  activeFor               Publication[]            @relation("PublicationActiveSnapshot")
  publicProjection        PublicStoryProjection?
  publicNewsProjection    PublicNewsProjection?
  publicProjectProjection PublicProjectProjection?

  @@index([publicationId, activatedAt])
  @@index([state])
  @@map("publication_snapshot")
}

// Read model for public Story detail. It is intentionally detached from
// mutable authoring tables; the public route reads this projection only.
model PublicStoryProjection {
  id            String              @id @default(uuid()) @db.Uuid
  publicationId String              @unique @db.Uuid
  snapshotId    String              @unique @db.Uuid
  slug          String              @unique @db.VarChar(160)
  headline      String
  deck          String?
  excerpt       String
  body          Json
  publishedAt   DateTime
  updatedAt     DateTime            @updatedAt
  publication   Publication         @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  snapshot      PublicationSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@map("public_story_projection")
}

// Read model for concise, chronological public News. Like Story projections,
// it is populated only by an approved release transaction.
model PublicNewsProjection {
  id            String              @id @default(uuid()) @db.Uuid
  publicationId String              @unique @db.Uuid
  snapshotId    String              @unique @db.Uuid
  slug          String              @unique @db.VarChar(160)
  headline      String
  summary       String
  body          Json
  publishedAt   DateTime
  expiresAt     DateTime?
  updatedAt     DateTime            @updatedAt
  publication   Publication         @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  snapshot      PublicationSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@index([expiresAt, publishedAt])
  @@map("public_news_projection")
}

// Read model for public Project detail and future index routes. It contains
// only released, privacy-safe editorial facts.
model PublicProjectProjection {
  id             String                    @id @default(uuid()) @db.Uuid
  publicationId  String                    @unique @db.Uuid
  snapshotId     String                    @unique @db.Uuid
  slug           String                    @unique @db.VarChar(160)
  title          String                    @db.VarChar(160)
  summary        String                    @db.VarChar(320)
  body           Json
  projectType    ProjectType
  projectStatus  ProjectStatus
  community      String                    @db.VarChar(120)
  county         String                    @db.VarChar(120)
  publicArea     String?                   @db.VarChar(160)
  startDate      DateTime?
  completionDate DateTime?
  publishedAt    DateTime
  updatedAt      DateTime                  @updatedAt
  publication    Publication               @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  snapshot       PublicationSnapshot       @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  impactFacts    PublicProjectImpactFact[]

  @@index([projectType, publishedAt])
  @@index([projectStatus, publishedAt])
  @@index([publishedAt])
  @@map("public_project_projection")
}

model PublicProjectImpactFact {
  id           String                  @id @default(uuid()) @db.Uuid
  projectionId String                  @db.Uuid
  label        String                  @db.VarChar(120)
  value        String                  @db.VarChar(240)
  unit         String?                 @db.VarChar(80)
  sortOrder    Int
  projection   PublicProjectProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)

  @@unique([projectionId, sortOrder])
  @@index([projectionId, sortOrder])
  @@map("public_project_impact_fact")
}

// Typed Story root. Public content lives in the released projection.
model Story {
  id              String                                @id @default(uuid()) @db.Uuid
  publicationId   String                                @unique @db.Uuid
  createdAt       DateTime                              @default(now())
  publication     Publication                           @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  storyConversion PublicStorySubmissionStoryConversion?

  @@map("story")
}

// Typed Project root. Project facts are revision-scoped and never operational
// construction, applicant, homeowner, or accounting records.
model Project {
  id            String      @id @default(uuid()) @db.Uuid
  publicationId String      @unique @db.Uuid
  createdAt     DateTime    @default(now())
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Restrict)

  @@map("project")
}

// Typed News root. Public content continues to live only in projections.
model NewsItem {
  id            String      @id @default(uuid()) @db.Uuid
  publicationId String      @unique @db.Uuid
  createdAt     DateTime    @default(now())
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Restrict)

  @@map("news_item")
}

// Code-owned singleton slots with a closed target-kind catalog in the
// application service. Rows are retained when superseded, ended, or cancelled.
model ContentPlacement {
  id                   String       @id @default(uuid()) @db.Uuid
  key                  PlacementKey
  publicationId        String       @db.Uuid
  startsAt             DateTime     @default(now())
  endsAt               DateTime?
  cancelledAt          DateTime?
  version              Int          @default(1)
  createdByAdminUserId String       @db.Uuid
  updatedByAdminUserId String       @db.Uuid
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  publication          Publication  @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  createdBy            AdminUser    @relation("ContentPlacementCreator", fields: [createdByAdminUserId], references: [id], onDelete: Restrict)
  updatedBy            AdminUser    @relation("ContentPlacementChanger", fields: [updatedByAdminUserId], references: [id], onDelete: Restrict)

  @@index([key, startsAt])
  @@index([publicationId])
  @@map("content_placement")
}

// Small, temporary operational communications. Site Notices are not
// Publications, placements, or permanent public archive records.
model SiteNotice {
  id                     String               @id @default(uuid()) @db.Uuid
  title                  String               @db.VarChar(160)
  message                String               @db.VarChar(500)
  severity               SiteNoticeSeverity
  targetArea             SiteNoticeTargetArea
  ctaLabel               String?              @db.VarChar(80)
  ctaUrl                 String?              @db.VarChar(2048)
  lifecycle              SiteNoticeLifecycle  @default(DRAFT)
