  statusChangedBy                        AdminUser?                            @relation("PublicStorySubmissionStatusChanger", fields: [statusChangedByAdminUserId], references: [id], onDelete: SetNull)
  intakeTokenUse                         PublicStoryIntakeTokenUse?
  submissionAttempts                     PublicStorySubmissionAttempt[]
  submissionMedia                        PublicStorySubmissionMedia[]
  mediaSubjects                          PublicStorySubmissionMediaSubject[]
  mediaClearances                        PublicStorySubmissionMediaClearance[]
  mediaPromotions                        PublicStorySubmissionMediaPromotion[]
  storyConversion                        PublicStorySubmissionStoryConversion?

  @@unique([id, version])
  @@index([status, receivedAt, id])
  @@index([receivedAt, id])
  @@map("public_story_submission")
}

// Restricted provenance for the one-time editorial handoff from confidential
// intake into the ordinary Story authoring domain. This never enters public
// projections or Story content.
model PublicStorySubmissionStoryConversion {
  id                      String                @id @default(uuid()) @db.Uuid
  submissionId            String                @unique @db.Uuid
  storyId                 String                @unique @db.Uuid
  sourceSubmissionVersion Int
  convertedByAdminUserId  String                @db.Uuid
  convertedAt             DateTime              @default(now())
  correlationId           String                @unique @db.Uuid
  createdAt               DateTime              @default(now())
